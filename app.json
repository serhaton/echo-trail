{
  "expo": {
    "name": "Echo Trail",
    "slug": "echo-trail",
    "scheme": "echotrail",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060A",
    "platforms": [
      "ios"
    ],
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "ios": {
      "bundleIdentifier": "com.serhatonal.echotrail",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05060A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "tr"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Your data is used to show you more relevant ads. You can keep playing either way."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458511713",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ],
          "delayAppMeasurementInit": true
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
